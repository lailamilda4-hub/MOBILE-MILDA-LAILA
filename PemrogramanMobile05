import 'package:flutter/material.dart';

void main() {
  runApp(const MyApp());
}



class Mahasiswa {
  String nim;
  String nama;
  String prodi;
  String kelas;

  Mahasiswa({
    required this.nim,
    required this.nama,
    required this.prodi,
    required this.kelas,
  });
}


class MyApp extends StatelessWidget {
  const MyApp({super.key});

  @override
  Widget build(BuildContext context) {
    return MaterialApp(
      debugShowCheckedModeBanner: false,
      title: 'Manajemen Data Mahasiswa',
      theme: ThemeData(
        primarySwatch: Colors.blue,
        useMaterial3: true,
      ),
      home: const DataMahasiswaPage(),
    );
  }
}



class DataMahasiswaPage extends StatefulWidget {
  const DataMahasiswaPage({super.key});

  @override
  State<DataMahasiswaPage> createState() => _DataMahasiswaPageState();
}

class _DataMahasiswaPageState extends State<DataMahasiswaPage> {
  
  List<Mahasiswa> mahasiswa = [
    Mahasiswa(
      nim: '231001',
      nama: 'Milda Laila',
      prodi: 'Manajemen Informatika',
      kelas: 'MI-3B',
    ),
    Mahasiswa(
      nim: '231002',
      nama: 'Fina Fanesa',
      prodi: 'Teknik Informatika',
      kelas: 'TI-5B',
    ),
    Mahasiswa(
      nim: '231003',
      nama: 'Citra Lestari',
      prodi: 'Sistem Informasi',
      kelas: 'SI-3A',
    ),
    Mahasiswa(
      nim: '231004',
      nama: 'Dilla Tiana',
      prodi: 'Manajemen Informatika',
      kelas: 'MI-3B',
    ),
    Mahasiswa(
      nim: '231005',
      nama: 'Fahril',
      prodi: 'Teknik Komputer',
      kelas: 'TK-3A',
    ),
  ];

  String searchText = '';

  
  String selectedProdi = 'Semua';

 
  List<Mahasiswa> get filteredMahasiswa {
    return mahasiswa.where((mhs) {
      final cocokSearch =
          mhs.nama.toLowerCase().contains(searchText.toLowerCase()) ||
          mhs.nim.toLowerCase().contains(searchText.toLowerCase());

      final cocokProdi =
          selectedProdi == 'Semua' || mhs.prodi == selectedProdi;

      return cocokSearch && cocokProdi;
    }).toList();
  }


  void tambahMahasiswa() async {
    final hasil = await Navigator.push(
      context,
      MaterialPageRoute(
        builder: (context) => const FormMahasiswaPage(),
      ),
    );

    if (hasil != null && hasil is Mahasiswa) {
      setState(() {
        mahasiswa.add(hasil);
      });
    }
  }



  void bukaDetail(Mahasiswa data) {
    Navigator.push(
      context,
      MaterialPageRoute(
        builder: (context) => DetailMahasiswaPage(
          mahasiswa: data,
          onUpdate: () {
            setState(() {});
          },
          onDelete: () {
            setState(() {
              mahasiswa.remove(data);
            });
          },
        ),
      ),
    );
  }

 

  @override
  Widget build(BuildContext context) {
    final dataTampil = filteredMahasiswa;

    return Scaffold(
      appBar: AppBar(
        title: const Text(
          'Data Mahasiswa',
          style: TextStyle(fontWeight: FontWeight.bold),
        ),
        centerTitle: true,
